# ==============================================================================
# 统一配置文件：接口用例集（api）+ UI 用例集（ui）共用
# 优先级：系统环境变量 > 本文件 > 代码里的默认值
# ==============================================================================

# 运行环境：测试环境 / 预生产环境 / 生产环境
ENV=测试环境

# 接口用例集项目名（python run.py api <项目名> 会覆盖本项；留空则必须用命令行指定）
API_PROJECT=假勤
# UI 用例集项目名（python run.py ui <项目名> 会覆盖本项）
UI_PROJECT=薪资结算包收款包链路
# 兼容旧配置：两个用例集都读不到上面两项时的兜底
CURRENT_PROJECT=薪资结算包收款包链路

# ==================== 数据库（两个用例集共用）====================
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=<数据库名>
HTTP_TIMEOUT=30
ACCESS_TOKEN_ADMIN=
WECOM_WEBHOOK=
WECOM_ENABLE=false
USER_TOKEN=
LOGIN_USER=
PASSWORD=
UI_LOGIN_BY_TOKEN=true

# ==================== 禅道（提单）====================
# 地址：禅道根地址，不要带 /api.php，例如 https://zentao.example.com
ZENTAO_URL=http://172.21.100.100:8101/zentao
# 账号：建议用专用机器人账号（需"提Bug"权限）；有 token 时可只填 token
ZENTAO_ACCOUNT=<禅道账号>
ZENTAO_PASSWORD=<禅道密码>
# 可选：已有 token 时直接填（免登录）
ZENTAO_TOKEN=
# 默认提单字段：产品 id / 模块 id / 指派给（禅道账号名）
ZENTAO_PRODUCT=1
ZENTAO_MODULE=393
ZENTAO_ASSIGNEE=
# 严重程度 1~4（1 最严重）/ 优先级 1~4（1 最高）/ 类型
ZENTAO_SEVERITY=3
ZENTAO_PRI=3
ZENTAO_TYPE=codeerror
# 影响版本（留空默认 trunk）
ZENTAO_OPENED_BUILD=trunk
ZENTAO_KEYWORDS=自动化
# 自签证书环境设 false
ZENTAO_VERIFY_SSL=true
# 是否允许无 --yes 直接提交（默认 false = 只出草稿，安全）
ZENTAO_AUTO_SUBMIT=false
