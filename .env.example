# ==============================================================================
# 接口自动化测试框架 - 配置模板（可提交到 git）
# 用法：复制为 .env（例如 copy .env.example .env）后填入真实值
# 优先级：系统环境变量（Jenkins 等） > .env > config/setting.py 里的默认值
# ==============================================================================

# 运行环境：测试环境 / 预生产环境 / 生产环境
ENV=测试环境

# 用例项目：假勤 / 调试
CURRENT_PROJECT=假勤

# 数据库（按环境填写；生产 / 预生产为占位，避免误连）
DB_HOST=<数据库地址>
DB_PORT=3306
DB_USER=<数据库账号>
DB_PASSWORD=<数据库密码>
DB_NAME=<数据库名>

# 接口默认超时（秒）
HTTP_TIMEOUT=30

# all.yaml 里 headers_user 用到的 token（可留空；留空且被引用时，对应用例会直接失败并提示"变量 ${user_token} 未定义"）
USER_TOKEN=

# 企业微信群机器人 Webhook（可选；留空则不发送通知）
# 格式：https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxxxxxxx
WECOM_WEBHOOK=

# 企业微信通知总开关（false 时不推送，即使上面配了 Webhook）
WECOM_ENABLE=true
# 通知内容上限（字节，企微硬性上限 4096）与请求超时（秒），一般不用改
#WECOM_MAX_CONTENT_BYTES=4000
#WECOM_TIMEOUT=10
